rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function staffPath() { return /databases/$(database)/documents/staff/$(request.auth.uid); }
    function isStaff() {
      return signedIn() && exists(staffPath()) &&
        get(staffPath()).data.active == true &&
        get(staffPath()).data.role in ['admin', 'employee'];
    }
    function isAdmin() {
      return isStaff() && get(staffPath()).data.role == 'admin';
    }
    function validTrackingOrderUpdate(id) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let token = request.resource.data.get('trackingId', '');
      return !changed.hasAny(['trackingId']) ||
        (!resource.data.keys().hasAny(['trackingId']) &&
         token is string && token.matches('^[a-f0-9]{64}$') &&
         existsAfter(/databases/$(database)/documents/publicTracking/$(token)) &&
         getAfter(/databases/$(database)/documents/publicTracking/$(token)).data.orderId == id);
    }
    function validOrderMoney() {
      return request.resource.data.estimate is number &&
        request.resource.data.paid is number &&
        request.resource.data.estimate >= 0 &&
        request.resource.data.paid >= 0 &&
        request.resource.data.paid <= request.resource.data.estimate;
    }
    match /staff/{uid} {
      allow get: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow list, create, update, delete: if isAdmin();
    }
    // El empleado puede cobrar solo el saldo exacto al entregar.
    // Una orden entregada queda bloqueada, salvo creación del QR de seguimiento.
    function employeeDeliveryPayment() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let beforePaid = resource.data.paid;
      let afterPaid = request.resource.data.paid;
      return resource.data.status != 'Entregado' &&
        request.resource.data.status == 'Entregado' &&
        changed.hasAny(['status']) &&
        request.resource.data.estimate == resource.data.estimate &&
        beforePaid is number && beforePaid >= 0 &&
        afterPaid == request.resource.data.estimate &&
        afterPaid > beforePaid &&
        request.resource.data.paidDate is string &&
        request.resource.data.paidDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }
    function employeeOrderUpdate(id) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let normalFields = ['client','phone','documentId','deviceType','device',
        'imei','accessories','fault','status','notes','deliveredAt','trackingId'];
      let paymentFields = ['client','phone','documentId','deviceType','device',
        'imei','accessories','fault','status','notes','deliveredAt','trackingId',
        'paid','paidDate'];
      let onlyQr = changed.hasOnly(['trackingId']) && changed.hasAny(['trackingId']);
      let canEdit = resource.data.status != 'Entregado' && (
        changed.hasOnly(normalFields) ||
        false
      );
      return request.resource.data.id == resource.data.id &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.estimate == resource.data.estimate &&
        (!changed.hasAny(['deliveredAt']) ||
          (resource.data.status != 'Entregado' &&
           request.resource.data.status == 'Entregado' &&
           !resource.data.keys().hasAny(['deliveredAt']) &&
           request.resource.data.deliveredAt is string)) &&
        (canEdit || onlyQr);
    }
    // Fase 7: el cambio de cobro exige un movimiento vinculado, en la misma transacción.
    function linkedPayment(id) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let pid = request.resource.data.get('lastPaymentId', '');
      return changed.hasAny(['paid']) &&
        changed.hasOnly(['paid','paidDate','lastPaymentId']) &&
        pid is string && pid.size() >= 10 &&
        pid != resource.data.get('lastPaymentId', '') &&
        existsAfter(/databases/$(database)/documents/payments/$(pid)) &&
        getAfter(/databases/$(database)/documents/payments/$(pid)).data.orderId == id &&
        getAfter(/databases/$(database)/documents/payments/$(pid)).data.amountCents -
          (request.resource.data.paid - resource.data.paid) * 100 < 0.001 &&
        getAfter(/databases/$(database)/documents/payments/$(pid)).data.amountCents -
          (request.resource.data.paid - resource.data.paid) * 100 > -0.001 &&
        getAfter(/databases/$(database)/documents/payments/$(pid)).data.actorUid == request.auth.uid &&
        request.resource.data.paid > resource.data.paid &&
        resource.data.status != 'Cancelado' &&
        request.resource.data.paidDate is string &&
        request.resource.data.paidDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }
    match /orders/{id} {
      allow read: if isStaff();
      allow create: if isStaff() && !request.resource.data.keys().hasAny(['trackingId']) &&
        validOrderMoney() &&
        (isAdmin() || (request.resource.data.estimate == 0 &&
          request.resource.data.paid == 0 && request.resource.data.paidDate == '' &&
          request.resource.data.status != 'Entregado' &&
          !request.resource.data.keys().hasAny(['warrantyDays','warrantyTerms','deliveredAt'])));
      allow update: if isStaff() && validOrderMoney() && validTrackingOrderUpdate(id) &&
        (linkedPayment(id) || (isAdmin() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['paid','lastPaymentId'])) || employeeOrderUpdate(id));
      allow delete: if isAdmin();
    }
    match /payments/{pid} {
      allow read: if isStaff();
      allow create: if isStaff() &&
        request.resource.data.keys().hasOnly(['orderId','amountCents','method','actorUid','actorName','createdAt']) &&
        request.resource.data.keys().hasAll(['orderId','amountCents','method','actorUid','actorName','createdAt']) &&
        request.resource.data.orderId is string &&
        request.resource.data.orderId.matches('^[0-9]{10,20}$') &&
        request.resource.data.amountCents is int &&
        request.resource.data.amountCents > 0 &&
        request.resource.data.method in ['Efectivo','Transferencia','Tarjeta'] &&
        request.resource.data.actorUid == request.auth.uid &&
        request.resource.data.actorName is string &&
        request.resource.data.actorName.size() <= 180 &&
        request.resource.data.createdAt == request.time &&
        exists(/databases/$(database)/documents/orders/$(request.resource.data.orderId)) &&
        getAfter(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.lastPaymentId == pid &&
        getAfter(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.paid -
          get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.paid - request.resource.data.amountCents / 100.0 < 0.00001 &&
        getAfter(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.paid -
          get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.paid - request.resource.data.amountCents / 100.0 > -0.00001;
      allow update, delete: if false;
    }
    match /cashClosings/{date} {
      allow read: if isAdmin();
      allow create: if isAdmin() &&
        request.resource.data.keys().hasOnly(['date','countedCashCents','expectedCashCents','actorUid','actorName','createdAt']) &&
        request.resource.data.keys().hasAll(['date','countedCashCents','expectedCashCents','actorUid','actorName','createdAt']) &&
        request.resource.data.date == date && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        request.resource.data.countedCashCents is int && request.resource.data.countedCashCents >= 0 &&
        request.resource.data.expectedCashCents is int && request.resource.data.expectedCashCents >= 0 &&
        request.resource.data.actorUid == request.auth.uid &&
        request.resource.data.actorName is string &&
        request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    match /expenses/{id} {
      allow read, write: if isAdmin();
    }
    match /settings/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }
    match /auditLogs/{id} {
      allow read, delete, update: if isAdmin();
      allow create: if isStaff() &&
        request.resource.data.actorUid == request.auth.uid &&
        request.resource.data.actorName is string &&
        request.resource.data.orderId is string &&
        request.resource.data.action is string &&
        request.resource.data.createdAt == request.time;
    }
    // Documento público con solo cuatro campos. ID aleatorio de 256 bits.
    function validPublicTracking(t) {
      return t.keys().hasOnly(['orderId','status','deviceType','receivedDate']) &&
        t.keys().hasAll(['orderId','status','deviceType','receivedDate']) &&
        t.orderId is string && t.orderId.matches('^[0-9]{10,20}$') &&
        t.status is string && t.status.size() <= 40 &&
        t.deviceType is string && t.deviceType.size() <= 60 &&
        t.receivedDate is string && t.receivedDate.size() <= 10 &&
        existsAfter(/databases/$(database)/documents/orders/$(t.orderId)) &&
        getAfter(/databases/$(database)/documents/orders/$(t.orderId)).data.status == t.status &&
        getAfter(/databases/$(database)/documents/orders/$(t.orderId)).data.deviceType == t.deviceType &&
        getAfter(/databases/$(database)/documents/orders/$(t.orderId)).data.createdAt is string &&
        getAfter(/databases/$(database)/documents/orders/$(t.orderId)).data.createdAt.matches('^' + t.receivedDate + '.*');
    }
    match /publicTracking/{token} {
      allow get: if token.matches('^[a-f0-9]{64}$');
      allow list: if false;
      allow create: if isStaff() && token.matches('^[a-f0-9]{64}$') &&
        validPublicTracking(request.resource.data) &&
        getAfter(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.trackingId == token;
      allow update: if isStaff() && validPublicTracking(request.resource.data) &&
        request.resource.data.orderId == resource.data.orderId &&
        getAfter(/databases/$(database)/documents/orders/$(resource.data.orderId)).data.trackingId == token;
      allow delete: if isAdmin() && !existsAfter(/databases/$(database)/documents/orders/$(resource.data.orderId));
    }
    match /{document=**} { allow read, write: if false; }
  }
}
